        "# stretch\n",
        "LOCATIONS = [\n",
        "    ('Charlottesville', 38.03, -78.51),\n",
        "    ('Orlando', 28.54, -81.38),\n",
        "]\n",
        "TARGET_DATES = ['2026-09-05', '2026-10-03']\n",
        "\n",
        "def pull_city(name, lat, lon):\n",
        "    \"\"\"Return a labelled frame for one city, using the fallback if the pull fails.\"\"\"\n",
        "    try:\n",
        "        df = get_weather(TARGET_DATES[0], TARGET_DATES[1], lat=lat, lon=lon)\n",
        "        df = df[df['time'].isin(TARGET_DATES)]\n",
        "        origin = 'open-meteo'\n",
        "    except (requests.RequestException, RuntimeError) as err:\n",
        "        print(f'{name}: live pull failed ({err}); using fallback sample')\n",
        "        df = FALLBACK\n",
        "        origin = 'fallback sample'\n",
        "    return df.assign(city=name, source=origin)\n",
        "\n",
        "by_city = (\n",
        "    pd.concat([pull_city(*loc) for loc in LOCATIONS], ignore_index=True)\n",
        "    .rename(columns={\n",
        "        'time': 'date',\n",
        "        'temperature_2m_max': 'temp_max',\n",
        "        'precipitation_sum': 'precip_mm',\n",
        "    })\n",
        "    .assign(date=lambda d: pd.to_datetime(d['date']))\n",
        "    [['city', 'date', 'temp_max', 'precip_mm', 'source']]\n",
        ")\n",
        "by_city"
